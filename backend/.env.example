JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
POSTGRES_PASSWORD=local-dietary-demo-password
DATABASE_URL=postgresql+psycopg://dietary:local-dietary-demo-password@localhost:5433/dietary
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
OFF_USER_AGENT=DietaryRiskPrototype/0.1 (set your project contact before public deployment)
# Optional model/source credentials: keep values on the backend.
#  APIFY_TOKEN=
# TYPESAFE_API_KEY=
# FIREWORKS_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
LABEL_MAX_TOKENS=2048
LOG_LEVEL=INFO
# Per-process token-bucket rate limits (per minute). Set RATE_LIMIT_ENABLED=false to disable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LABEL_EXTRACT_PER_MINUTE=10
RATE_LIMIT_PROVIDER_READS_PER_MINUTE=30
RATE_LIMIT_RECOMMENDATIONS_PER_MINUTE=20
# Global request body cap in bytes (default 6 MiB); label uploads keep a 5 MiB image cap.
MAX_BODY_BYTES=6291456
