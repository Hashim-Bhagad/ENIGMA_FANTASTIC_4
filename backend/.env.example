JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
POSTGRES_PASSWORD=local-dietary-demo-password
DATABASE_URL=postgresql+psycopg://dietary:local-dietary-demo-password@localhost:5433/dietary
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
OFF_USER_AGENT=DietaryRiskPrototype/0.1 (set your project contact before public deployment)
# Optional model/source credentials: keep values on the backend.
#  APIFY_TOKEN=
# THEVERIFICO_API_KEY=
# TYPESAFE_API_KEY=
# FIREWORKS_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
LABEL_MAX_TOKENS=2048
# Health-report reading: its own timeout, output budget, upload cap and page cap.
REPORT_TIMEOUT=60
REPORT_MAX_TOKENS=3072
REPORT_MAX_BYTES=10485760
REPORT_MAX_PAGES=5
# Dish-name drafting: the model proposes a starting ingredient list the user must correct.
DISH_DRAFT_TIMEOUT=45
DISH_DRAFT_MAX_TOKENS=3072
# Model review of unresolved dish wording: the same shape of call as the dish draft.
DISH_REVIEW_TIMEOUT=25
DISH_REVIEW_MAX_TOKENS=3072
# Live Food.com recipe search: one bounded, pay-per-result actor run per new query.
# RECIPES_LIVE_ENABLED=false turns the live path off; MAX_ITEMS caps the spend.
RECIPES_LIVE_ENABLED=true
RECIPES_LIVE_MAX_ITEMS=5
RECIPES_LIVE_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
# Per-process token-bucket rate limits (per minute). Set RATE_LIMIT_ENABLED=false to disable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LABEL_EXTRACT_PER_MINUTE=10
RATE_LIMIT_REPORT_EXTRACT_PER_MINUTE=10
RATE_LIMIT_PROVIDER_READS_PER_MINUTE=30
RATE_LIMIT_RECOMMENDATIONS_PER_MINUTE=20
RATE_LIMIT_BARCODE_SCAN_PER_MINUTE=20
RATE_LIMIT_DISH_DRAFT_PER_MINUTE=10
RATE_LIMIT_DISH_REVIEW_PER_MINUTE=10
RATE_LIMIT_RECIPES_LIVE_PER_MINUTE=5
# Global request body cap in bytes (default 6 MiB); label uploads keep a 5 MiB image cap
# and report uploads their own REPORT_MAX_BYTES cap, so raise this above 6 MiB to
# accept report files larger than the global cap.
MAX_BODY_BYTES=16777216
